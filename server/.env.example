# 数据库连接（MySQL 8，Windows 默认端口 3306）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=liuguang_travel

# API 端口
PORT=3000

# 允许跨域的前端地址（逗号分隔；开发版前端静态服务）
CORS_ORIGIN=http://localhost:8123,http://127.0.0.1:8123

# JWT 密钥（生产必须更换；生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=请生成随机32位hex填这里

# 内容纠错管理接口令牌（/api/admin/* 用；生成方式同上）
ADMIN_TOKEN=请生成随机32位hex填这里
